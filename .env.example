# Copy to .env.local and fill in.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/dinkin-pirates

# Public site origin (used to build /go/{id}?src=... links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth (Auth.js v5) — generate with: npx auth secret
AUTH_SECRET=
# Optional Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Dev email login is on outside production; set true to force it on in prod (not recommended)
AUTH_DEV_LOGIN=false
# Comma-separated emails that get the "owner" role on first sign-in (Captain's Log access)
OWNER_EMAILS=

# Salt for hashing click IPs (voyage_clicks.ipHash)
IP_HASH_SALT=change-me

# Facebook Page / Messenger (Sprint 3)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=

# Shared secret for cron endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Set to "enabled" to run the frontend on in-browser mock data (MSW), no MongoDB needed
NEXT_PUBLIC_API_MOCKING=
